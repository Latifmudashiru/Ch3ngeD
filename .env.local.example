NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Optional, worker only (never expose to the browser). Falls back to the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional for local worker. If Blender is not in PATH, point this to blender.exe.
# Example Windows install path:
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.3\blender.exe
BLENDER_PATH=blender
# RIG_PATH defaults (after env): MINECRAFT_RIG_PATH if set, then bundled 
# `minecraft-player-rigged/.../minecraft player rigged.blend`.
# Set USE_WOODPLANK_RIG=1 to prefer ../../Woodplank Rig v3.3/4_5-Woodplank.v3_3.Default.blend when present.
MINECRAFT_RIG_PATH=
USE_WOODPLANK_RIG=
# Optional: enables Claude planning in the worker.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=

# --- Monadical SDXL Minecraft skin generator (primary) ---
# For dev: ngrok URL from your Google Colab notebook (e.g. https://xxxx.ngrok.io/generate)
# For prod: HuggingFace Inference Endpoint URL
HF_ENDPOINT_URL=
HF_TOKEN=

# --- Legacy GPT-Image (deprecated fallback, used only if HF_ENDPOINT_URL is not set) ---
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=low

# Skip palette/symmetry/face restore (debug only).
# SKIP_SKIN_POST_PROCESS=
